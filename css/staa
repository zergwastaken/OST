* {
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-inline: 50px;
  background-color: #333;
  color: white;
}

header, header nav{
  overflow: hidden;
}

header nav a {
  float: left;
  display: block;
  color: #f2f2f2;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
}

header nav a:hover {
  background-color: #ddd;
  color: black;
}

.logotext{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
}

.content {
  background-color: #ddd;
  padding: 10px;
}

#timerscontainer{
    margin-top: 50px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px;
}

.timer-card{
    min-width: 700px;
    padding: 25px;
    background-color: #868686;
    border-radius: 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.inline-div{
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 5px;
  padding: 0px;
  margin: 0px;
}


.header-container { position: relative; display: inline-block; }
#emoji-display { cursor: pointer; margin-right: 10px; }
#text-display { cursor: pointer; }

.emoji-menu {
  display: none;
  position: absolute;
  transform: translateY(80px);
  background: #fff;
  border: 1px solid #ccc;
  padding: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  z-index: 100;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
}

.emoji-menu.active { display: grid; }
.emoji-option { cursor: pointer; font-size: 1.5rem; padding: 5px; }
.emoji-option:hover { background: #f0f0f0; }